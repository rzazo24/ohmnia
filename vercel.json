{
  "crons": [
    {
      "path": "/api/cron/resumen",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/resumen",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/resumen",
      "schedule": "30 10 * * *"
    }
  ],
  "functions": {
    "api/cron/resumen.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/resumenes/latest.json",
      "destination": "/api/resumen"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
