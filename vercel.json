{
  "schedules": {
    "resumen-diario": {
      "schedule": "30 10 * * *",
      "timezone": "Europe/Madrid",
      "path": "/api/cron/resumen",
      "requestMethod": "GET"
    },
    "resumen-reintento-1": {
      "schedule": "30 11 * * *",
      "timezone": "Europe/Madrid",
      "path": "/api/cron/resumen",
      "requestMethod": "GET"
    },
    "resumen-reintento-2": {
      "schedule": "30 12 * * *",
      "timezone": "Europe/Madrid",
      "path": "/api/cron/resumen",
      "requestMethod": "GET"
    }
  },
  "functions": {
    "api/cron/resumen.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/resumenes/latest.json",
      "destination": "/api/resumen"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
